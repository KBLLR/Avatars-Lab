{
  "name": "avatar-labs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:hydrate": "node scripts/hydrate-avatar-assets.mjs",
    "dev": "zsh scripts/dev.zsh",
    "dev:ui": "vite",
    "prebuild": "npm run assets:hydrate",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:modernization": "node packages/tests/modernization-contract.mjs",
    "test:launcher": "playwright test packages/tests/playwright/launcher.spec.mjs --config playwright.config.mjs",
    "test:gemma": "playwright test packages/tests/playwright/gemma-avatar.spec.mjs --config playwright.config.mjs",
    "test:openresponses": "playwright test packages/tests/playwright/openresponses.spec.mjs --config playwright.config.mjs",
    "test:cases": "playwright test packages/tests/playwright/cases.spec.mjs --config playwright.config.mjs",
    "test:browser": "npm run test:launcher && npm run test:gemma && npm run test:openresponses && npm run test:cases",
    "benchmark:gemma": "node scripts/benchmark-gemma-avatar.mjs",
    "verify": "npm run typecheck && npm run test:modernization && npm run build",
    "preview": "vite preview",
    "test:contract": "node packages/tests/contract-tests.mjs",
    "test:bridge": "node packages/tests/bridge-spec-test.mjs",
    "test:headaudio": "playwright test packages/tests/playwright/headaudio.spec.mjs --config playwright.config.mjs",
    "test:e2e": "playwright test packages/tests/playwright/talkinghead.e2e.spec.mjs --config playwright.config.mjs",
    "smoke": "zsh scripts/smoke.zsh",
    "e2e": "zsh scripts/e2e.zsh",
    "all": "zsh scripts/all.zsh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@met4citizen/headaudio": "^0.1.0",
    "@met4citizen/headtts": "1.2.0",
    "@met4citizen/talkinghead": "^1.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "9.6.1",
    "lil-gui": "^0.21.0",
    "lucide": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three-stdlib": "^2.36.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.3",
    "three": "0.185.1",
    "vite": "8.1.5"
  }
}
